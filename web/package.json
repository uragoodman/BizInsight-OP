  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
