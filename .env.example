DEEPSEEK_API_KEY=
# 本项目实际使用 OpenCode Go 订阅（https://opencode.ai/docs/zh-cn/go/）作为 OpenAI-compatible 端点。
# 若改用 DeepSeek 官方 API，此处填 https://api.deepseek.com。
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
LLM_PROVIDER=opencode_go_openai_compatible
# This is the single model setting used by the main app, local Debug, and Code Agent.
LLM_MODEL=hy3
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
# —— 模型路由：按用途分配不同模型（fast=高频轻任务 / standard=常规 / quality=高要求审核）——
LLM_FAST_MODEL=
LLM_STANDARD_MODEL=
LLM_QUALITY_MODEL=
# 各路由档位的单价（每 1K token），用于用量账本的成本估算。
LLM_FAST_INPUT_COST_PER_1K=0
LLM_FAST_OUTPUT_COST_PER_1K=0
LLM_QUALITY_INPUT_COST_PER_1K=0
LLM_QUALITY_OUTPUT_COST_PER_1K=0
# Complex intent routing is active for all authenticated tenants by default.
# Raw questions are sent to the configured LLM provider. To return to legacy
# triage, set COMPLEX_ROUTE_MODE=off and restart the application workers.
COMPLEX_ROUTE_MODE=active
COMPLEX_ROUTE_CANARY_ENABLED=true
COMPLEX_ROUTE_CANARY_TENANTS=["*"]
COMPLEX_ROUTE_CANARY_TEMPLATES=["rfm_segmentation","cohort_retention","customer_lifecycle"]
COMPLEX_ROUTE_CANARY_SAMPLE_RATE=1.0
SEMANTIC_INTERPRETER_MODE=active
SEMANTIC_INTERPRETER_SEND_RAW_QUESTION=true
SEMANTIC_INTERPRETER_VALIDATION_REPAIR_ENABLED=true
# The interaction preset owns connect/idle/total deadlines; the old timeout
# remains for legacy callers. Active validation repair retries once only for
# parse/schema/Validator failures.
SEMANTIC_INTERPRETER_INTERACTION_POLICY=stream_fast
SEMANTIC_INTERPRETER_TIMEOUT_SECONDS=10
SEMANTIC_INTERPRETER_MAX_TOKENS=2048
SEMANTIC_INTERPRETER_INLINE_SHADOW_ENABLED=false
SEMANTIC_INTERPRETER_SPAN_RESOLUTION_ENABLED=true
SEMANTIC_INTERPRETER_REQUEST_SCOPE_NORMALIZATION_ENABLED=true
SEMANTIC_INTERPRETER_CAPTURE_RAW_OUTPUT=false
# 单价版本号：随调价更新，便于审计「不同时期使用不同价格」的用量记录。
LLM_PRICE_VERSION=configured-v1
# Preflight each LLM request against the remaining turn token budget. Reserve
# the request's output cap plus this input-estimate margin before sending.
LLM_BUDGET_PREFLIGHT_MARGIN_RATIO=0.15
# Keep the deterministic Critic call-reduction policy observational until its
# decision log has been reviewed. `active` skips advisory reviews only for
# fully validated registered numeric decompositions; groundedness still runs.
CRITIC_OPTIONAL_REVIEW_CASCADE_MODE=shadow
# Example per-user budgets for a personal installation. 0 means unlimited.
# Cost quotas use estimated cost, so configure the LLM_*_COST_PER_1K rates above.
LLM_USER_DAILY_TOKEN_LIMIT=100000
LLM_USER_MONTHLY_TOKEN_LIMIT=2000000
LLM_USER_DAILY_COST_LIMIT=5.0
LLM_USER_MONTHLY_COST_LIMIT=50.0
QDRANT_URL=http://localhost:6333
RAG_TIMEOUT_SECONDS=30
QDRANT_COLLECTION=bizinsight_knowledge
# WP3 user-preference memory is isolated from RAG and metric-semantic collections.
MEM0_ENABLED=false
MEM0_QDRANT_COLLECTION=bizinsight_user_preferences_v1
MEM0_QDRANT_URL=
MEM0_QDRANT_API_KEY=
MEM0_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEM0_EMBEDDING_DIMS=512
MEM0_HMAC_SECRET=
MEM0_SCOPE_VERSION=v1
MEM0_SEARCH_TIMEOUT_SECONDS=1.5
MEM0_WRITE_TIMEOUT_SECONDS=5.0
MEM0_BREAKER_FAILURES=5
MEM0_BREAKER_WINDOW_SECONDS=30
MEM0_TOP_K_PER_TYPE=5
MEM0_TOP_K_TOTAL=10
MEM0_RELEVANCE_THRESHOLD=0.55
# Optional only for the Mem0 infer=True SDK contract probe; typed writes use infer=False.
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=
# WP4 worker URL: provision a dedicated, least-privilege role with access only
# to memory_registry, memory_preference_overlays, memory_outbox and audit.
MEMORY_PREFERENCE_DATABASE_URL=
MEMORY_PREFERENCE_WORKER_LEASE_SECONDS=60
MEMORY_PREFERENCE_CLEANUP_INTERVAL_SECONDS=60
MEMORY_PREFERENCE_METRICS_PORT=9101
MEMORY_PREFERENCE_PAYLOAD_KEY=
# During rotation retain all versions referenced by pending Outbox rows.
MEMORY_PREFERENCE_PAYLOAD_KEYRING={}
MEMORY_PREFERENCE_PAYLOAD_CURRENT_KEY_VERSION=v1
# One-off provisioning only; never pass the admin URL to the worker container.
MEMORY_PREFERENCE_ROLE_ADMIN_URL=
MEMORY_PREFERENCE_WORKER_PASSWORD=
POSTGRES_URL=
BIZINSIGHT_POSTGRES_PASSWORD=
CODE_ANALYSIS_WORKER_DB_PASSWORD=
UNLEASH_POSTGRES_PASSWORD=
UNLEASH_FRONTEND_TOKEN=
# Use the non-superuser bizinsight_app role through SET ROLE for API queries.
# Keep false only for a local database that has not been bootstrapped yet.
DB_USE_RLS_ROLE=true
DB_RLS_ROLE=bizinsight_app
TRACE_DIR=data/traces
QUALITY_DATA_DIR=data/quality
TRACE_BACKEND=file
CHECKPOINT_PATH=data/checkpoints/langgraph.sqlite
# Use postgres in multi-tenant/production deployment; sqlite is development-only.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DURABILITY=exit
PHASE6_STORE_PATH=data/phase6.sqlite
ANALYSIS_WRITE_TOKEN=
RAG_BACKEND=local_hybrid
RAG_KNOWLEDGE_ROOT=docs/knowledge
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_MODEL_REVISION=
RAG_TOP_K=5
RAG_CANDIDATE_K=12
RAG_INDEX_VERSION=v1
RAG_CHUNK_PIPELINE_VERSION=section-v1
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=80
RAG_MANIFEST_PATH=data/rag/index_manifest.json
RAG_RELEASE_MANIFEST_PATH=data/rag/release_manifest.json
RAG_CACHE_DIR=data/cache/llama_index
RAG_OFFLINE_EMBEDDINGS=true
RAG_VECTOR_WEIGHT=0.40
RAG_SPARSE_WEIGHT=0.45
RAG_SEMANTIC_WEIGHT=0.35
RAG_METADATA_WEIGHT=0.20
# Set to 0 only for trusted development datasets. Production default is 5.
RESULT_POLICY_MIN_CELL_SIZE=5
RESULT_POLICY_ALLOWED_CLASSIFICATIONS_JSON=["public","internal"]
RESULT_POLICY_MASK_FIELDS_JSON={}
RESULT_POLICY_EXPORT_APPROVAL_REQUIRED=true
RESULT_POLICY_MAX_DERIVED_DIMENSIONS=3
CHAT_EXECUTION_STALE_SECONDS=600
ENVIRONMENT=development
ANOMALY_COOLDOWN_HOURS=24
REPORT_CHART_DIR=data/reports/charts
MAX_GRAPH_STEPS=48
MAX_TOOL_CALLS=16
MAX_LATENCY_MS=600000
MAX_TOKENS=60000
MAX_COST=5.0
MAX_REVISIONS=1
# production should use human_review; development may use approve_with_risk.
CRITIC_LIMIT_POLICY=human_review
MCP_TIMEOUT_SECONDS=10
MCP_TRANSPORT=stdio
REMOTE_MCP_URL=
REMOTE_MCP_OAUTH_TOKEN=
REMOTE_MCP_OAUTH_SCOPE=bizinsight.read
REMOTE_MCP_AUDIENCE=
TOOL_PERMISSION_POLICY_PATH=config/governance/tool_permissions.json
ABAC_DATABASE_ENABLED=false
PERMISSION_EVENT_WEBHOOK_URL=
PERMISSION_EVENT_WEBHOOK_SECRET=
PERMISSION_EVENT_DATABASE_URL=
PERMISSION_EVENT_WORKER_INTERVAL_SECONDS=30
LIFECYCLE_RECONCILE_INTERVAL_SECONDS=60
# Provision the NOBYPASSRLS login and least-privilege lifecycle role with
# `python -m scripts.setup_rls_role`; Compose selects DB_RLS_ROLE for the worker.
LIFECYCLE_RECONCILE_DB_PASSWORD=
# Optional full URL override; otherwise Compose builds it from the password above.
LIFECYCLE_RECONCILE_DATABASE_URL=
RESULT_POLICY_REIDENTIFICATION_THRESHOLD=3
RESULT_POLICY_REIDENTIFICATION_MAX_QUASI_IDENTIFIERS=2
RESULT_POLICY_DATABASE_MASKING_ENABLED=true
LLM_TIMEOUT_SECONDS=300
LLM_RESILIENCE_ATTEMPTS=1
LLM_EXTRACT_MAX_TOKENS=8192
CRITIC_MAX_OUTPUT_TOKENS=1024
LLM_CHAT_MAX_TOKENS=4096
RAG_TIMEOUT_SECONDS=10
DATABASE_TIMEOUT_SECONDS=10
# Local Phoenix via the Docker Compose OpenTelemetry Collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318/v1/traces
# Override OTEL_COLLECTOR_HOST_PORT if 14318 is already occupied.
OTEL_COLLECTOR_HOST_PORT=14318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Phase 7: the server derives tenant identity from JWT/API key, never from body/query/prompt.
# Development only: omit credentials with TENANT_AUTH_REQUIRED=false to use platform demo scope.
TENANT_AUTH_SECRET=
TENANT_AUTH_REQUIRED=false
# Password login is enabled when TENANT_AUTH_SECRET is set. Use the bootstrap
# token exactly once to create the first internal platform administrator.
AUTH_SESSION_HOURS=8
AUTH_BOOTSTRAP_TOKEN=
TENANT_CHECKPOINT_SCHEMA=governance
TENANT_RAG_COLLECTION_SUFFIX=tenant
DELEGATION_SIGNING_SECRET=
# Phase 11 Code Agent: keep fake/local defaults for development. Production
# uses an S3-compatible store, an internal model proxy token and a worker.
CODE_ANALYSIS_DATABASE_URL=
CODE_ANALYSIS_STORAGE_BACKEND=local
CODE_ANALYSIS_STORAGE_DIR=data/code_analysis
CODE_ANALYSIS_S3_ENDPOINT=
CODE_ANALYSIS_S3_BUCKET=bizinsight-code-analysis
CODE_ANALYSIS_S3_ACCESS_KEY=
CODE_ANALYSIS_S3_SECRET_KEY=
CODE_ANALYSIS_S3_SERVER_SIDE_ENCRYPTION=
CODE_ANALYSIS_S3_KMS_KEY_ID=
CODE_ANALYSIS_PROVIDER=fake
CODE_ANALYSIS_OPENCODE_URL=http://opencode-generator:4096
CODE_ANALYSIS_OPENCODE_USERNAME=opencode
CODE_ANALYSIS_OPENCODE_PASSWORD=
CODE_ANALYSIS_OPENCODE_TIMEOUT_SECONDS=600
CODE_ANALYSIS_OPENCODE_PROTOCOL_RETRIES=1
CODE_ANALYSIS_OPENCODE_VERSION=1.18.5
CODE_ANALYSIS_MODEL_PROXY_URL=
CODE_ANALYSIS_MODEL_PROXY_TOKEN=
# Code Analysis uses the same model as the rest of the application.
# Keep the model configured only in LLM_MODEL above; both local Debug and Docker Compose read it.
CODE_ANALYSIS_UPSTREAM_API_KEY=
CODE_ANALYSIS_UPSTREAM_BASE_URL=
CODE_ANALYSIS_MODEL_PROXY_MAX_REQUESTS_PER_MINUTE=20
CODE_ANALYSIS_MODEL_PROXY_MAX_CONCURRENT_REQUESTS=2
CODE_ANALYSIS_MODEL_PROXY_UPSTREAM_MAX_RETRIES=3
CODE_ANALYSIS_MODEL_PROXY_UPSTREAM_BACKOFF_SECONDS=2
CODE_ANALYSIS_MODEL_PROXY_UPSTREAM_TIMEOUT_SECONDS=600
CODE_ANALYSIS_MODEL_PROXY_MAX_OUTPUT_TOKENS=16000
CODE_ANALYSIS_MAX_UNCOMPRESSED_BYTES=268435456
CODE_ANALYSIS_MAX_STORED_UPLOAD_BYTES_PER_USER=209715200
CODE_ANALYSIS_MAX_ACTIVE_JOBS_PER_USER=3
CODE_ANALYSIS_MAX_JOBS_PER_USER_PER_DAY=20
CODE_ANALYSIS_MAX_JOB_ATTEMPTS=3
CODE_ANALYSIS_JOB_DEADLINE_SECONDS=1800
CODE_ANALYSIS_MAX_REPAIR_ATTEMPTS=1
CODE_ANALYSIS_MAX_OUTPUT_BYTES=20971520
CODE_ANALYSIS_MAX_RESULT_BYTES=2097152
CODE_ANALYSIS_RUNNER_MEMORY_MB=1024
CODE_ANALYSIS_RUNNER_CPU_CORES=0.5
CODE_ANALYSIS_RUNNER_PIDS=64
